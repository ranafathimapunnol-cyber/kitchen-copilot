# Kitchen Copilot web app — environment template
#
# Copy to apps/web/.env.local for local development.
# This template must never contain secrets. Variables starting with
# NEXT_PUBLIC_ are embedded in the browser bundle and are always public.

# Base URL of the Kitchen Copilot API as seen from the browser.
#   Through nginx (docker compose --profile core):  http://localhost:8080
#   API container directly:                          http://localhost:8000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

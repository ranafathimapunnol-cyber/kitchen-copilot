# Kitchen Copilot API — environment template
#
# Copy to services/api/.env and fill in real values locally.
# Never commit the real .env file. This template must never contain secrets.
#
# Inside Docker Compose, the `api` service overrides DATABASE_URL with the
# internal address of the `db` container (see compose.yaml), so the value
# below is only used by tools started outside Docker.

APP_NAME=Kitchen Copilot API
APP_VERSION=0.1.0

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# The authoritative development database is the Docker PostgreSQL server,
# published on host port 5433.
#
# WARNING: port 5432 on this machine may be a separate, locally installed
# PostgreSQL server holding a different Kitchen Copilot database. Do not point
# this file at port 5432 unless that is a deliberate, approved decision.
DATABASE_URL=postgresql+psycopg://kitchen:CHANGE_ME@localhost:5433/kitchen_copilot_db

# ---------------------------------------------------------------------------
# Security
# ---------------------------------------------------------------------------
# Generate a long random value, for example:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_VALUE

ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Cookie settings. Keep COOKIE_SECURE=false only for local HTTP development.
# Production behind HTTPS must use COOKIE_SECURE=true.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
# COOKIE_DOMAIN=

# ---------------------------------------------------------------------------
# AI (disabled)
# ---------------------------------------------------------------------------
# The AI agent must stay disabled until it is explicitly approved.
AGENT_ENABLED=false
GEMINI_MODEL=gemini-3.1-flash-lite
# Leave empty unless working on an approved AI task. Never commit a real key.
GEMINI_API_KEY=
